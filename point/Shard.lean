def Encloses (x : ℝ) (B : PRO.Iv) : Prop :=
  B.ok = true ∧ (B.lo : ℝ) ≤ x * PRO.S ∧ x * PRO.S ≤ B.hi

theorem discharge_valid {xs : List ℝ} {Bs : List PRO.Iv}
    (h : List.Forall₂ (PRO.memAt PRO.S) xs Bs)
    (hv : ∀ B ∈ Bs, B.ok = true) : List.Forall₂ Encloses xs Bs := by
  induction h with
  | nil => exact .nil
  | @cons x B xs Bs hx hxs ih =>
    have hb : B.ok = true := hv B (by simp)
    exact .cons ⟨hb, hx hb⟩ (ih (fun b hmem => hv b (by simp [hmem])))

