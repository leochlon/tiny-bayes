theorem identity03301 (u v : ℝ) :
    C ((12+u)/32) ((13+v)/32) = bern88 coeff03301 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff03301, Nat.choose]
  ring

theorem coeff_bound03301 : ∀ i j, -certA ≤ coeff03301 i j ∧ coeff03301 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff03301, certA]

theorem leaf03301 (x y : ℝ)
    (hx0 : (12:ℝ)/32 ≤ x) (hx1 : x ≤ (13:ℝ)/32)
    (hy0 : (13:ℝ)/32 ≤ y) (hy1 : y ≤ (14:ℝ)/32) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff03301 (32*x-12) (32*y-13) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound03301
  rw [← identity03301] at h
  have ex : (12 + (32*x-12))/32=x := by ring
  have ey : (13 + (32*y-13))/32=y := by ring
  rwa [ex, ey] at h

#print axioms leaf03301
