theorem identity031 (u v : ℝ) :
    C ((2+u)/8) ((3+v)/8) = bern88 coeff031 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff031, Nat.choose]
  ring

theorem coeff_bound031 : ∀ i j, -certA ≤ coeff031 i j ∧ coeff031 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff031, certA]

theorem leaf031 (x y : ℝ)
    (hx0 : (2:ℝ)/8 ≤ x) (hx1 : x ≤ (3:ℝ)/8)
    (hy0 : (3:ℝ)/8 ≤ y) (hy1 : y ≤ (4:ℝ)/8) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff031 (8*x-2) (8*y-3) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound031
  rw [← identity031] at h
  have ex : (2 + (8*x-2))/8=x := by ring
  have ey : (3 + (8*y-3))/8=y := by ring
  rwa [ex, ey] at h

#print axioms leaf031
end
