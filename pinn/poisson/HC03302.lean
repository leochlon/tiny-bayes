theorem identity03302 (u v : ℝ) :
    C ((13+u)/32) ((12+v)/32) = bern88 coeff03302 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff03302, Nat.choose]
  ring

theorem coeff_bound03302 : ∀ i j, -certA ≤ coeff03302 i j ∧ coeff03302 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff03302, certA]

theorem leaf03302 (x y : ℝ)
    (hx0 : (13:ℝ)/32 ≤ x) (hx1 : x ≤ (14:ℝ)/32)
    (hy0 : (12:ℝ)/32 ≤ y) (hy1 : y ≤ (13:ℝ)/32) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff03302 (32*x-13) (32*y-12) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound03302
  rw [← identity03302] at h
  have ex : (13 + (32*x-13))/32=x := by ring
  have ey : (12 + (32*y-12))/32=y := by ring
  rwa [ex, ey] at h

#print axioms leaf03302
