theorem identity23 (u v : ℝ) :
    C ((3+u)/4) ((1+v)/4) = bern88 coeff23 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff23, Nat.choose]
  ring

theorem coeff_bound23 : ∀ i j, -certA ≤ coeff23 i j ∧ coeff23 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff23, certA]

theorem leaf23 (x y : ℝ)
    (hx0 : (3:ℝ)/4 ≤ x) (hx1 : x ≤ (4:ℝ)/4)
    (hy0 : (1:ℝ)/4 ≤ y) (hy1 : y ≤ (2:ℝ)/4) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff23 (4*x-3) (4*y-1) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound23
  rw [← identity23] at h
  have ex : (3 + (4*x-3))/4=x := by ring
  have ey : (1 + (4*y-1))/4=y := by ring
  rwa [ex, ey] at h

#print axioms leaf23
end
