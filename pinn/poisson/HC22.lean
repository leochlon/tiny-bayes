theorem identity22 (u v : ℝ) :
    C ((3+u)/4) ((0+v)/4) = bern88 coeff22 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff22, Nat.choose]
  ring

theorem coeff_bound22 : ∀ i j, -certA ≤ coeff22 i j ∧ coeff22 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff22, certA]

theorem leaf22 (x y : ℝ)
    (hx0 : (3:ℝ)/4 ≤ x) (hx1 : x ≤ (4:ℝ)/4)
    (hy0 : (0:ℝ)/4 ≤ y) (hy1 : y ≤ (1:ℝ)/4) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff22 (4*x-3) (4*y-0) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound22
  rw [← identity22] at h
  have ex : (3 + (4*x-3))/4=x := by ring
  have ey : (0 + (4*y-0))/4=y := by ring
  rwa [ex, ey] at h

#print axioms leaf22
end
