theorem identity033003 (u v : ℝ) :
    C ((25+u)/64) ((25+v)/64) = bern88 coeff033003 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff033003, Nat.choose]
  ring

theorem coeff_bound033003 : ∀ i j, -certA ≤ coeff033003 i j ∧ coeff033003 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff033003, certA]

theorem leaf033003 (x y : ℝ)
    (hx0 : (25:ℝ)/64 ≤ x) (hx1 : x ≤ (26:ℝ)/64)
    (hy0 : (25:ℝ)/64 ≤ y) (hy1 : y ≤ (26:ℝ)/64) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff033003 (64*x-25) (64*y-25) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound033003
  rw [← identity033003] at h
  have ex : (25 + (64*x-25))/64=x := by ring
  have ey : (25 + (64*y-25))/64=y := by ring
  rwa [ex, ey] at h

