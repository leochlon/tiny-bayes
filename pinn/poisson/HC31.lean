theorem identity31 (u v : ℝ) :
    C ((2+u)/4) ((3+v)/4) = bern88 coeff31 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff31, Nat.choose]
  ring

theorem coeff_bound31 : ∀ i j, -certA ≤ coeff31 i j ∧ coeff31 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff31, certA]

theorem leaf31 (x y : ℝ)
    (hx0 : (2:ℝ)/4 ≤ x) (hx1 : x ≤ (3:ℝ)/4)
    (hy0 : (3:ℝ)/4 ≤ y) (hy1 : y ≤ (4:ℝ)/4) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff31 (4*x-2) (4*y-3) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound31
  rw [← identity31] at h
  have ex : (2 + (4*x-2))/4=x := by ring
  have ey : (3 + (4*y-3))/4=y := by ring
  rwa [ex, ey] at h

#print axioms leaf31
end
