theorem identity20 (u v : ℝ) :
    C ((2+u)/4) ((0+v)/4) = bern88 coeff20 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff20, Nat.choose]
  ring

theorem coeff_bound20 : ∀ i j, -certA ≤ coeff20 i j ∧ coeff20 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff20, certA]

theorem leaf20 (x y : ℝ)
    (hx0 : (2:ℝ)/4 ≤ x) (hx1 : x ≤ (3:ℝ)/4)
    (hy0 : (0:ℝ)/4 ≤ y) (hy1 : y ≤ (1:ℝ)/4) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff20 (4*x-2) (4*y-0) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound20
  rw [← identity20] at h
  have ex : (2 + (4*x-2))/4=x := by ring
  have ey : (0 + (4*y-0))/4=y := by ring
  rwa [ex, ey] at h

#print axioms leaf20
end
