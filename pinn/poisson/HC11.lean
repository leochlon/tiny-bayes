theorem identity11 (u v : ℝ) :
    C ((0+u)/4) ((3+v)/4) = bern88 coeff11 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff11, Nat.choose]
  ring

theorem coeff_bound11 : ∀ i j, -certA ≤ coeff11 i j ∧ coeff11 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff11, certA]

theorem leaf11 (x y : ℝ)
    (hx0 : (0:ℝ)/4 ≤ x) (hx1 : x ≤ (1:ℝ)/4)
    (hy0 : (3:ℝ)/4 ≤ y) (hy1 : y ≤ (4:ℝ)/4) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff11 (4*x-0) (4*y-3) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound11
  rw [← identity11] at h
  have ex : (0 + (4*x-0))/4=x := by ring
  have ey : (3 + (4*y-3))/4=y := by ring
  rwa [ex, ey] at h

#print axioms leaf11
end
end PoissonR3
