theorem identity03213 (u v : ℝ) :
    C ((13+u)/32) ((11+v)/32) = bern88 coeff03213 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff03213, Nat.choose]
  ring

theorem coeff_bound03213 : ∀ i j, -certA ≤ coeff03213 i j ∧ coeff03213 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff03213, certA]

theorem leaf03213 (x y : ℝ)
    (hx0 : (13:ℝ)/32 ≤ x) (hx1 : x ≤ (14:ℝ)/32)
    (hy0 : (11:ℝ)/32 ≤ y) (hy1 : y ≤ (12:ℝ)/32) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff03213 (32*x-13) (32*y-11) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound03213
  rw [← identity03213] at h
  have ex : (13 + (32*x-13))/32=x := by ring
  have ey : (11 + (32*y-11))/32=y := by ring
  rwa [ex, ey] at h

