theorem identity0332 (u v : ℝ) :
    C ((7+u)/16) ((6+v)/16) = bern88 coeff0332 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff0332, Nat.choose]
  ring

theorem coeff_bound0332 : ∀ i j, -certA ≤ coeff0332 i j ∧ coeff0332 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff0332, certA]

theorem leaf0332 (x y : ℝ)
    (hx0 : (7:ℝ)/16 ≤ x) (hx1 : x ≤ (8:ℝ)/16)
    (hy0 : (6:ℝ)/16 ≤ y) (hy1 : y ≤ (7:ℝ)/16) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff0332 (16*x-7) (16*y-6) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound0332
  rw [← identity0332] at h
  have ex : (7 + (16*x-7))/16=x := by ring
  have ey : (6 + (16*y-6))/16=y := by ring
  rwa [ex, ey] at h

#print axioms leaf0332
end
