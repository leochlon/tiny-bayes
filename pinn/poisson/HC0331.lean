theorem identity0331 (u v : ℝ) :
    C ((6+u)/16) ((7+v)/16) = bern88 coeff0331 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff0331, Nat.choose]
  ring

theorem coeff_bound0331 : ∀ i j, -certA ≤ coeff0331 i j ∧ coeff0331 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff0331, certA]

theorem leaf0331 (x y : ℝ)
    (hx0 : (6:ℝ)/16 ≤ x) (hx1 : x ≤ (7:ℝ)/16)
    (hy0 : (7:ℝ)/16 ≤ y) (hy1 : y ≤ (8:ℝ)/16) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff0331 (16*x-6) (16*y-7) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound0331
  rw [← identity0331] at h
  have ex : (6 + (16*x-6))/16=x := by ring
  have ey : (7 + (16*y-7))/16=y := by ring
  rwa [ex, ey] at h

#print axioms leaf0331
end
