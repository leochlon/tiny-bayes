theorem identity21 (u v : ℝ) :
    C ((2+u)/4) ((1+v)/4) = bern88 coeff21 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff21, Nat.choose]
  ring

theorem coeff_bound21 : ∀ i j, -certA ≤ coeff21 i j ∧ coeff21 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff21, certA]

theorem leaf21 (x y : ℝ)
    (hx0 : (2:ℝ)/4 ≤ x) (hx1 : x ≤ (3:ℝ)/4)
    (hy0 : (1:ℝ)/4 ≤ y) (hy1 : y ≤ (2:ℝ)/4) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff21 (4*x-2) (4*y-1) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound21
  rw [← identity21] at h
  have ex : (2 + (4*x-2))/4=x := by ring
  have ey : (1 + (4*y-1))/4=y := by ring
  rwa [ex, ey] at h

#print axioms leaf21
end
