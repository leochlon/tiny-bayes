theorem identity32 (u v : ℝ) :
    C ((3+u)/4) ((2+v)/4) = bern88 coeff32 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff32, Nat.choose]
  ring

theorem coeff_bound32 : ∀ i j, -certA ≤ coeff32 i j ∧ coeff32 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff32, certA]

theorem leaf32 (x y : ℝ)
    (hx0 : (3:ℝ)/4 ≤ x) (hx1 : x ≤ (4:ℝ)/4)
    (hy0 : (2:ℝ)/4 ≤ y) (hy1 : y ≤ (3:ℝ)/4) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff32 (4*x-3) (4*y-2) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound32
  rw [← identity32] at h
  have ex : (3 + (4*x-3))/4=x := by ring
  have ey : (2 + (4*y-2))/4=y := by ring
  rwa [ex, ey] at h

#print axioms leaf32
end
