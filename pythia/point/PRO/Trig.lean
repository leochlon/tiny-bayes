import Mathlib
import PRO.Elem
import PRO.Force

/-! A literal table of the rotary constants `cos (m / 10^f)`, `sin (m / 10^f)` for positions `m < 8`,
`f < 4`. Each entry is checked by the kernel to contain the sound enclosure `cosI m f` / `sinI m f`
of `PRO.Elem` (`trig_tab_ok`), so the table is certified, not trusted. Outside the table `cosT`,
`sinT` fall back to `cosI`, `sinI`. The table only saves recomputation. -/

namespace PRO

/-- `X` is valid and lies inside `B`. -/
def inB (X B : Iv) : Bool := stIv X fun X' => X'.ok && decide (B.lo ≤ X'.lo) && decide (X'.hi ≤ B.hi)

theorem memAt_inB {x : ℝ} {X B : Iv} (hx : memAt S x X) (h : inB X B = true) : memAt S x B := by
  simp only [inB, stIv_eq, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨hok, h1⟩, h2⟩ := h
  obtain ⟨a1, a2⟩ := hx hok
  intro _
  have b1 : (B.lo : ℝ) ≤ X.lo := by exact_mod_cast h1
  have b2 : (X.hi : ℝ) ≤ B.hi := by exact_mod_cast h2
  exact ⟨b1.trans a1, a2.trans b2⟩

