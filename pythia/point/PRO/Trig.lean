def cosT (m f : Nat) : Iv := if m < 8 ∧ f < 4 then (cosTab.getD m []).getD f zero else cosI m f

def sinT (m f : Nat) : Iv := if m < 8 ∧ f < 4 then (sinTab.getD m []).getD f zero else sinI m f

set_option maxHeartbeats 0 in
/-- Kernel check: every table entry contains the computed enclosure. -/
theorem trig_tab_ok : ∀ m : Nat, m < 8 → ∀ f : Nat, f < 4 →
    (inB (cosI m f) ((cosTab.getD m []).getD f zero) &&
      inB (sinI m f) ((sinTab.getD m []).getD f zero)) = true := by
  decide +kernel

theorem memAt_cosT (m f : ℕ) : memAt S (Real.cos ((m : ℝ) / (10 : ℝ) ^ f)) (cosT m f) := by
  unfold cosT
  split_ifs with h
  · have h2 := trig_tab_ok m h.1 f h.2
    simp only [Bool.and_eq_true] at h2
    exact memAt_inB (memAt_cos m f) h2.1
  · exact memAt_cos m f

theorem memAt_sinT (m f : ℕ) : memAt S (Real.sin ((m : ℝ) / (10 : ℝ) ^ f)) (sinT m f) := by
  unfold sinT
  split_ifs with h
  · have h2 := trig_tab_ok m h.1 f h.2
    simp only [Bool.and_eq_true] at h2
    exact memAt_inB (memAt_sin m f) h2.2
  · exact memAt_sin m f

