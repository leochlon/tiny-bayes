theorem identity01 (u v : ℝ) :
    C ((0+u)/4) ((1+v)/4) = bern88 coeff01 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff01, Nat.choose]
  ring

theorem coeff_bound01 : ∀ i j, -certA ≤ coeff01 i j ∧ coeff01 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff01, certA]

theorem leaf01 (x y : ℝ)
    (hx0 : (0:ℝ)/4 ≤ x) (hx1 : x ≤ (1:ℝ)/4)
    (hy0 : (1:ℝ)/4 ≤ y) (hy1 : y ≤ (2:ℝ)/4) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff01 (4*x-0) (4*y-1) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound01
  rw [← identity01] at h
  have ex : (0 + (4*x-0))/4=x := by ring
  have ey : (1 + (4*y-1))/4=y := by ring
  rwa [ex, ey] at h

#print axioms leaf01
end
