theorem identity03211 (u v : ℝ) :
    C ((12+u)/32) ((11+v)/32) = bern88 coeff03211 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff03211, Nat.choose]
  ring

theorem coeff_bound03211 : ∀ i j, -certA ≤ coeff03211 i j ∧ coeff03211 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff03211, certA]

theorem leaf03211 (x y : ℝ)
    (hx0 : (12:ℝ)/32 ≤ x) (hx1 : x ≤ (13:ℝ)/32)
    (hy0 : (11:ℝ)/32 ≤ y) (hy1 : y ≤ (12:ℝ)/32) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff03211 (32*x-12) (32*y-11) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound03211
  rw [← identity03211] at h
  have ex : (12 + (32*x-12))/32=x := by ring
  have ey : (11 + (32*y-11))/32=y := by ring
  rwa [ex, ey] at h

#print axioms leaf03211
end
