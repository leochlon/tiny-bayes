theorem identity033001 (u v : ℝ) :
    C ((24+u)/64) ((25+v)/64) = bern88 coeff033001 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff033001, Nat.choose]
  ring

theorem coeff_bound033001 : ∀ i j, -certA ≤ coeff033001 i j ∧ coeff033001 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff033001, certA]

theorem leaf033001 (x y : ℝ)
    (hx0 : (24:ℝ)/64 ≤ x) (hx1 : x ≤ (25:ℝ)/64)
    (hy0 : (25:ℝ)/64 ≤ y) (hy1 : y ≤ (26:ℝ)/64) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff033001 (64*x-24) (64*y-25) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound033001
  rw [← identity033001] at h
  have ex : (24 + (64*x-24))/64=x := by ring
  have ey : (25 + (64*y-25))/64=y := by ring
  rwa [ex, ey] at h

