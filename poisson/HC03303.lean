theorem identity03303 (u v : ℝ) :
    C ((13+u)/32) ((13+v)/32) = bern88 coeff03303 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff03303, Nat.choose]
  ring

theorem coeff_bound03303 : ∀ i j, -certA ≤ coeff03303 i j ∧ coeff03303 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff03303, certA]

theorem leaf03303 (x y : ℝ)
    (hx0 : (13:ℝ)/32 ≤ x) (hx1 : x ≤ (14:ℝ)/32)
    (hy0 : (13:ℝ)/32 ≤ y) (hy1 : y ≤ (14:ℝ)/32) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff03303 (32*x-13) (32*y-13) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound03303
  rw [← identity03303] at h
  have ex : (13 + (32*x-13))/32=x := by ring
  have ey : (13 + (32*y-13))/32=y := by ring
  rwa [ex, ey] at h

