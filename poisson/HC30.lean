theorem identity30 (u v : ℝ) :
    C ((2+u)/4) ((2+v)/4) = bern88 coeff30 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff30, Nat.choose]
  ring

theorem coeff_bound30 : ∀ i j, -certA ≤ coeff30 i j ∧ coeff30 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff30, certA]

theorem leaf30 (x y : ℝ)
    (hx0 : (2:ℝ)/4 ≤ x) (hx1 : x ≤ (3:ℝ)/4)
    (hy0 : (2:ℝ)/4 ≤ y) (hy1 : y ≤ (3:ℝ)/4) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff30 (4*x-2) (4*y-2) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound30
  rw [← identity30] at h
  have ex : (2 + (4*x-2))/4=x := by ring
  have ey : (2 + (4*y-2))/4=y := by ring
  rwa [ex, ey] at h

#print axioms leaf30
end
