theorem identity0320 (u v : ℝ) :
    C ((6+u)/16) ((4+v)/16) = bern88 coeff0320 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff0320, Nat.choose]
  ring

theorem coeff_bound0320 : ∀ i j, -certA ≤ coeff0320 i j ∧ coeff0320 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff0320, certA]

theorem leaf0320 (x y : ℝ)
    (hx0 : (6:ℝ)/16 ≤ x) (hx1 : x ≤ (7:ℝ)/16)
    (hy0 : (4:ℝ)/16 ≤ y) (hy1 : y ≤ (5:ℝ)/16) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff0320 (16*x-6) (16*y-4) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound0320
  rw [← identity0320] at h
  have ex : (6 + (16*x-6))/16=x := by ring
  have ey : (4 + (16*y-4))/16=y := by ring
  rwa [ex, ey] at h

#print axioms leaf0320
end
end PoissonR3
