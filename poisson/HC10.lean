theorem identity10 (u v : ℝ) :
    C ((0+u)/4) ((2+v)/4) = bern88 coeff10 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff10, Nat.choose]
  ring

theorem coeff_bound10 : ∀ i j, -certA ≤ coeff10 i j ∧ coeff10 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff10, certA]

theorem leaf10 (x y : ℝ)
    (hx0 : (0:ℝ)/4 ≤ x) (hx1 : x ≤ (1:ℝ)/4)
    (hy0 : (2:ℝ)/4 ≤ y) (hy1 : y ≤ (3:ℝ)/4) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff10 (4*x-0) (4*y-2) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound10
  rw [← identity10] at h
  have ex : (0 + (4*x-0))/4=x := by ring
  have ey : (2 + (4*y-2))/4=y := by ring
  rwa [ex, ey] at h

#print axioms leaf10
end
