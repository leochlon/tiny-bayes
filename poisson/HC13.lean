theorem identity13 (u v : ℝ) :
    C ((1+u)/4) ((3+v)/4) = bern88 coeff13 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff13, Nat.choose]
  ring

theorem coeff_bound13 : ∀ i j, -certA ≤ coeff13 i j ∧ coeff13 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff13, certA]

theorem leaf13 (x y : ℝ)
    (hx0 : (1:ℝ)/4 ≤ x) (hx1 : x ≤ (2:ℝ)/4)
    (hy0 : (3:ℝ)/4 ≤ y) (hy1 : y ≤ (4:ℝ)/4) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff13 (4*x-1) (4*y-3) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound13
  rw [← identity13] at h
  have ex : (1 + (4*x-1))/4=x := by ring
  have ey : (3 + (4*y-3))/4=y := by ring
  rwa [ex, ey] at h

#print axioms leaf13
end
