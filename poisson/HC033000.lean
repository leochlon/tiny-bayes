theorem identity033000 (u v : ℝ) :
    C ((24+u)/64) ((24+v)/64) = bern88 coeff033000 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff033000, Nat.choose]
  ring

theorem coeff_bound033000 : ∀ i j, -certA ≤ coeff033000 i j ∧ coeff033000 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff033000, certA]

theorem leaf033000 (x y : ℝ)
    (hx0 : (24:ℝ)/64 ≤ x) (hx1 : x ≤ (25:ℝ)/64)
    (hy0 : (24:ℝ)/64 ≤ y) (hy1 : y ≤ (25:ℝ)/64) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff033000 (64*x-24) (64*y-24) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound033000
  rw [← identity033000] at h
  have ex : (24 + (64*x-24))/64=x := by ring
  have ey : (24 + (64*y-24))/64=y := by ring
  rwa [ex, ey] at h

