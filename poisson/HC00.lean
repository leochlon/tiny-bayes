theorem identity00 (u v : ℝ) :
    C ((0+u)/4) ((0+v)/4) = bern88 coeff00 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff00, Nat.choose]
  ring

theorem coeff_bound00 : ∀ i j, -certA ≤ coeff00 i j ∧ coeff00 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff00, certA]

theorem leaf00 (x y : ℝ)
    (hx0 : (0:ℝ)/4 ≤ x) (hx1 : x ≤ (1:ℝ)/4)
    (hy0 : (0:ℝ)/4 ≤ y) (hy1 : y ≤ (1:ℝ)/4) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff00 (4*x-0) (4*y-0) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound00
  rw [← identity00] at h
  have ex : (0 + (4*x-0))/4=x := by ring
  have ey : (0 + (4*y-0))/4=y := by ring
  rwa [ex, ey] at h

#print axioms leaf00
end
end PoissonR3
