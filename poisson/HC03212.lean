theorem identity03212 (u v : ℝ) :
    C ((13+u)/32) ((10+v)/32) = bern88 coeff03212 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff03212, Nat.choose]
  ring

theorem coeff_bound03212 : ∀ i j, -certA ≤ coeff03212 i j ∧ coeff03212 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff03212, certA]

theorem leaf03212 (x y : ℝ)
    (hx0 : (13:ℝ)/32 ≤ x) (hx1 : x ≤ (14:ℝ)/32)
    (hy0 : (10:ℝ)/32 ≤ y) (hy1 : y ≤ (11:ℝ)/32) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff03212 (32*x-13) (32*y-10) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound03212
  rw [← identity03212] at h
  have ex : (13 + (32*x-13))/32=x := by ring
  have ey : (10 + (32*y-10))/32=y := by ring
  rwa [ex, ey] at h

#print axioms leaf03212
end
