theorem identity02 (u v : ℝ) :
    C ((1+u)/4) ((0+v)/4) = bern88 coeff02 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff02, Nat.choose]
  ring

theorem coeff_bound02 : ∀ i j, -certA ≤ coeff02 i j ∧ coeff02 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff02, certA]

theorem leaf02 (x y : ℝ)
    (hx0 : (1:ℝ)/4 ≤ x) (hx1 : x ≤ (2:ℝ)/4)
    (hy0 : (0:ℝ)/4 ≤ y) (hy1 : y ≤ (1:ℝ)/4) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff02 (4*x-1) (4*y-0) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound02
  rw [← identity02] at h
  have ex : (1 + (4*x-1))/4=x := by ring
  have ey : (0 + (4*y-0))/4=y := by ring
  rwa [ex, ey] at h

#print axioms leaf02
end
