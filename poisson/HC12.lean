theorem identity12 (u v : ℝ) :
    C ((1+u)/4) ((2+v)/4) = bern88 coeff12 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff12, Nat.choose]
  ring

theorem coeff_bound12 : ∀ i j, -certA ≤ coeff12 i j ∧ coeff12 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff12, certA]

theorem leaf12 (x y : ℝ)
    (hx0 : (1:ℝ)/4 ≤ x) (hx1 : x ≤ (2:ℝ)/4)
    (hy0 : (2:ℝ)/4 ≤ y) (hy1 : y ≤ (3:ℝ)/4) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff12 (4*x-1) (4*y-2) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound12
  rw [← identity12] at h
  have ex : (1 + (4*x-1))/4=x := by ring
  have ey : (2 + (4*y-2))/4=y := by ring
  rwa [ex, ey] at h

#print axioms leaf12
end
