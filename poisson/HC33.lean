theorem identity33 (u v : ℝ) :
    C ((3+u)/4) ((3+v)/4) = bern88 coeff33 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff33, Nat.choose]
  ring

theorem coeff_bound33 : ∀ i j, -certA ≤ coeff33 i j ∧ coeff33 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff33, certA]

theorem leaf33 (x y : ℝ)
    (hx0 : (3:ℝ)/4 ≤ x) (hx1 : x ≤ (4:ℝ)/4)
    (hy0 : (3:ℝ)/4 ≤ y) (hy1 : y ≤ (4:ℝ)/4) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff33 (4*x-3) (4*y-3) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound33
  rw [← identity33] at h
  have ex : (3 + (4*x-3))/4=x := by ring
  have ey : (3 + (4*y-3))/4=y := by ring
  rwa [ex, ey] at h

#print axioms leaf33
end
