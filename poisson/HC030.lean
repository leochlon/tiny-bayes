theorem identity030 (u v : ℝ) :
    C ((2+u)/8) ((2+v)/8) = bern88 coeff030 u v := by
  rw [C_eq_power]
  norm_num [CPower, bern88, bern8, basis8, Fin.sum_univ_succ, coeff030, Nat.choose]
  ring

theorem coeff_bound030 : ∀ i j, -certA ≤ coeff030 i j ∧ coeff030 i j ≤ certA := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [coeff030, certA]

theorem leaf030 (x y : ℝ)
    (hx0 : (2:ℝ)/8 ≤ x) (hx1 : x ≤ (3:ℝ)/8)
    (hy0 : (2:ℝ)/8 ≤ y) (hy1 : y ≤ (3:ℝ)/8) : |C x y| ≤ certA := by
  have h := bern88_abs_le coeff030 (8*x-2) (8*y-2) certA
    (by linarith) (by linarith) (by linarith) (by linarith) coeff_bound030
  rw [← identity030] at h
  have ex : (2 + (8*x-2))/8=x := by ring
  have ey : (2 + (8*y-2))/8=y := by ring
  rwa [ex, ey] at h

#print axioms leaf030
end
